# Application Settings
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database & Queue
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/scraper_db
DATABASE_URL=sqlite+aiosqlite:///./data/scraper.db
REDIS_URL=redis://localhost:6379/0

# Concurrency & Crawling
MAX_CONCURRENT_REQUESTS=50
HTTP_TIMEOUT=30
BROWSER_TIMEOUT=45
MAX_RETRIES=5
FRESHNESS_HOURS=24

# Target Collection Counts
TARGET_STARTUPS=1000
TARGET_PRODUCTS=1000
TARGET_RESEARCH_PAPERS=1000

# LLM Provider Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# GitHub API
GITHUB_TOKEN=your_github_personal_access_token_here

# Google Sheets API Integration
GOOGLE_SHEETS_CREDENTIALS_FILE=./service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheet_id_here
EXPORT_DIR=./data/processed
